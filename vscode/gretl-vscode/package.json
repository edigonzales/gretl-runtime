{
  "name": "gretl-runtime-vscode",
  "displayName": "GRETL Runtime",
  "description": "Static language support for GRETL Runtime jobs. Requires Java 25.",
  "version": "0.1.0",
  "publisher": "edigonzales",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edigonzales/gretl-runtime"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:gretl-runtime",
    "onCustomEditor:gretlRuntime.modeler"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax and templates are available; the Java language server requires workspace trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "gretl-runtime",
        "aliases": [
          "GRETL Runtime"
        ],
        "filenames": [
          "job.groovy",
          "settings.gretl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {"command":"gretlRuntime.selectSourceContext","title":"GRETL Runtime: Select Source Context"},
      {
        "command": "gretlRuntime.restartServer",
        "title": "GRETL: Restart Language Server"
      },
      {
        "command": "gretlRuntime.stopServer",
        "title": "GRETL: Stop Language Server"
      },
      {
        "command": "gretlRuntime.showOutput",
        "title": "GRETL: Show Language Server Output"
      },
      {
        "command": "gretlRuntime.newJob",
        "title": "GRETL: New Job"
      },
      {
        "command": "gretlRuntime.useActiveFile",
        "title": "GRETL: Use Active File as Runtime Job"
      },
      {
        "command": "gretlRuntime.openModeler",
        "title": "GRETL: Open Modeler"
      },
      {
        "command": "gretlRuntime.showSelectionInModeler",
        "title": "GRETL: Show Selection in Modeler"
      }
    ],
    "configuration": {
      "title": "GRETL Runtime",
      "properties": {
        "gretlRuntime.javaPath": {
          "type": "string",
          "default": "java",
          "scope": "machine",
          "description": "Java 25 executable. No shell expansion or automatic download."
        },
        "gretlRuntime.serverJarPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional location of an identical bundled server JAR. Its digest must match the bundle."
        },
        "gretlRuntime.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "de"
          ],
          "default": "auto",
          "description": "Language of server diagnostics."
        }
      }
    },
    "grammars": [
      {
        "language": "gretl-runtime",
        "scopeName": "source.groovy.gretl-runtime",
        "path": "./syntaxes/groovy.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "gretlRuntime.modeler",
        "displayName": "GRETL Modeler",
        "selector": [
          {
            "filenamePattern": "*.groovy"
          },
          {
            "filenamePattern": "settings.gretl"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gretlRuntime.openModeler",
          "when": "resourceLangId == gretl-runtime",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test:includes": "node --test test/source-context.test.mjs test/fragment-documents.test.mjs test/host.test.mjs test/read-query.test.mjs test/edit-guard.test.mjs test/modeler-edit-plan.test.mjs test/modeler-state.test.mjs test/modeler-controller.test.mjs test/modeler-intent.test.mjs test/modeler-resource.test.mjs test/workbench-driver.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "package": "npm run check && npm run build && vsce package --no-dependencies --out dist/gretl-runtime.vsix && node scripts/inventory.mjs",
    "test:package": "node --test test/package/*.test.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.144.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
