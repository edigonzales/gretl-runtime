<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>ch.so.agi.gretl</groupId><artifactId>gretl-runtime-parent</artifactId><version>6.0.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>gretl-vscode</artifactId><packaging>pom</packaging>
  <dependencies><dependency><groupId>ch.so.agi.gretl</groupId><artifactId>gretl-lsp</artifactId><version>${project.version}</version><classifier>jar-with-dependencies</classifier><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency></dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><configuration><filesets><fileset><directory>dist</directory></fileset><fileset><directory>server</directory></fileset></filesets></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><executions>
      <execution><id>extension-locked-dependencies</id><phase>generate-resources</phase><goals><goal>run</goal></goals><configuration><target><exec executable="npm" dir="${project.basedir}" failonerror="true"><arg value="ci"/><arg value="--ignore-scripts"/></exec></target></configuration></execution>
      <execution>
        <id>extension-host-tests</id><phase>test</phase><goals><goal>run</goal></goals>
        <configuration>
          <skip>${skipTests}</skip>
          <target><exec executable="npm" dir="${project.basedir}" failonerror="true"><arg value="test"/></exec></target>
        </configuration>
      </execution>
      <execution><id>installed-extension-package</id><phase>package</phase><goals><goal>run</goal></goals><configuration><target><exec executable="npm" dir="${project.basedir}" failonerror="true"><arg value="run"/><arg value="package"/></exec></target></configuration></execution>
      <execution>
        <id>extension-package-tests</id><phase>verify</phase><goals><goal>run</goal></goals>
        <configuration>
          <skip>${skipTests}</skip>
          <target><exec executable="npm" dir="${project.basedir}" failonerror="true"><arg value="run"/><arg value="test:package"/></exec></target>
        </configuration>
      </execution>
    </executions></plugin>
  </plugins></build>
</project>
