INTERLIS 2.4;

MODEL SnapshotOptional (de) AT "mailto:test@example.org" VERSION "2026-11-11" =
  TOPIC Data =
    CLASS Observation =
      BFS_Nr : MANDATORY 1 .. 9999;
      Jahr : MANDATORY 2000 .. 2100;
      Anzahl : MANDATORY 0 .. 999999;
      UNIQUE BFS_Nr, Jahr;
    END Observation;
  END Data;
END SnapshotOptional.
