{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gretl.example.invalid/tooling/operations-v1.schema.json",
  "title": "GRETL descriptive operation catalog v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1
    },
    "dslVersion": {
      "type": "string",
      "minLength": 1
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "shape": {
                  "$ref": "#/$defs/shape"
                },
                "required": {
                  "type": "boolean"
                },
                "hasDefault": {
                  "type": "boolean"
                },
                "defaultValue": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/value"
                    }
                  ]
                },
                "allowedValues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "example": {
                  "type": "string",
                  "minLength": 1
                },
                "pathRole": {
                  "enum": [
                    null,
                    "JOB_RESOURCE",
                    "OUTPUT",
                    "WORK",
                    "EXTERNAL"
                  ]
                },
                "sensitive": {
                  "type": "boolean"
                },
                "hints": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "description",
                "shape",
                "required",
                "hasDefault",
                "defaultValue",
                "allowedValues",
                "example",
                "pathRole",
                "sensitive",
                "hints"
              ]
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "shape": {
                  "$ref": "#/$defs/shape"
                },
                "nullable": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "description",
                "shape",
                "nullable"
              ]
            }
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "voidResult": {
            "type": "boolean"
          }
        },
        "required": [
          "operationId",
          "symbol",
          "description",
          "origin",
          "inputs",
          "outputs",
          "example",
          "voidResult"
        ]
      }
    },
    "coverage": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "runtimeVersion",
    "dslVersion",
    "catalogId",
    "producers",
    "operations",
    "coverage"
  ],
  "$defs": {
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Text",
            "Boolean",
            "Integer",
            "Decimal",
            "Path",
            "ListOf",
            "MapOf",
            "Opaque"
          ]
        },
        "runtimeType": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        }
      },
      "required": [
        "kind",
        "runtimeType",
        "children"
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Null",
            "Text",
            "Boolean",
            "Integer",
            "Decimal",
            "Path",
            "Enum",
            "Uri",
            "Duration",
            "List",
            "Map"
          ]
        },
        "scalar": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "entries": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "required": [
        "kind",
        "scalar",
        "items",
        "entries"
      ]
    }
  }
}
