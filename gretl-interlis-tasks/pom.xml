<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ch.so.agi.gretl</groupId>
    <artifactId>gretl-runtime-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>gretl-interlis-tasks</artifactId>
  <packaging>jar</packaging>
  <name>GRETL INTERLIS format tasks</name>
  <description>gretl-next format tasks with native Shapefile I/O and INTERLIS validation.</description>

  <repositories>
    <repository>
      <id>interlis-releases</id>
      <url>https://jars.interlis.ch</url>
      <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
      <snapshots><enabled>true</enabled><updatePolicy>never</updatePolicy></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>ch.so.agi.gretl</groupId>
      <artifactId>gretl-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.so.agi.gretl</groupId>
      <artifactId>gretl-i18n</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>iox-wkf</artifactId>
      <version>${iox-wkf.version}</version>
      <exclusions>
        <exclusion><groupId>org.geotools</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>ili2pg</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>ili2gpkg</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>ili2c-tool</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>ili2c-core</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>iox-ili</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.github.sogis</groupId>
      <artifactId>iox-formats</artifactId>
      <version>${iox-formats.version}</version>
      <exclusions>
        <exclusion><groupId>org.geotools</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>iox-wkf</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ili2c-core</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ili2c-tool</artifactId>
      <exclusions>
        <exclusion><groupId>javax.activation</groupId><artifactId>activation</artifactId></exclusion>
        <exclusion><groupId>com.sun.xml.bind</groupId><artifactId>jaxb-core</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>iox-ili</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ili2pg</artifactId>
      <exclusions>
        <exclusion><groupId>ch.ehi</groupId><artifactId>ehisqlgen</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>iox-ili</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ch.ehi</groupId>
      <artifactId>ehisqlgen</artifactId>
      <version>${ehisqlgen.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ili2duckdb</artifactId>
      <version>${ili2duckdb.version}</version>
      <exclusions>
        <exclusion><groupId>ch.ehi</groupId><artifactId>ehisqlgen</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>iox-ili</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.github.sogis</groupId>
      <artifactId>av2ch</artifactId>
      <version>${av2ch.version}</version>
      <exclusions>
        <exclusion><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>av2geobau</artifactId>
      <version>${av2geobau.version}</version>
      <exclusions>
        <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ili2gpkg</artifactId>
      <exclusions>
        <exclusion><groupId>ch.ehi</groupId><artifactId>ehisqlgen</artifactId></exclusion>
        <exclusion><groupId>ch.interlis</groupId><artifactId>iox-ili</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ilivalidator</artifactId>
      <version>${ilivalidator.version}</version>
      <exclusions>
        <exclusion><groupId>javax.activation</groupId><artifactId>activation</artifactId></exclusion>
        <exclusion><groupId>com.sun.xml.bind</groupId><artifactId>jaxb-core</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.github.sogis</groupId>
      <artifactId>ilivalidator-custom-functions</artifactId>
      <version>${ilivalidator-custom-functions.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.sogis</groupId>
      <artifactId>ilivalidator-custom-functions-geometries</artifactId>
      <version>${ilivalidator-custom-functions-geometries.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.geowerkstatt.ilivalidator.extensions.functions</groupId>
      <artifactId>geow-interlis-functions</artifactId>
      <version>${geow-interlis-functions.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.geowerkstatt.ilivalidator.extensions.functions</groupId>
      <artifactId>interlis-functions-ngk-so</artifactId>
      <version>${interlis-functions-ngk-so.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <version>${duckdb.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>ch.so.agi.gretl</groupId>
      <artifactId>gretl-runner</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource><directory>src/standard-functions/resources</directory></testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>production-module-boundary</id>
            <phase>validate</phase><goals><goal>enforce</goal></goals>
            <configuration><rules><bannedDependencies>
              <searchTransitive>true</searchTransitive>
              <message>Production dependencies inside GRETL are limited to API and i18n; test dependencies remain separate.</message>
              <excludes><exclude>ch.so.agi.gretl:*:*:*:compile</exclude><exclude>ch.so.agi.gretl:*:*:*:runtime</exclude><exclude>ch.so.agi.gretl:*:*:*:provided</exclude></excludes>
              <includes><include>ch.so.agi.gretl:gretl-api</include><include>ch.so.agi.gretl:gretl-i18n</include></includes>
            </bannedDependencies></rules></configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>standard-validation-function-selection</id>
            <phase>package</phase><goals><goal>jar</goal></goals>
            <configuration>
              <classifier>standard-functions</classifier>
              <classesDirectory>${project.basedir}/src/standard-functions/resources</classesDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>independent-validator-runtime-classpath</id>
            <phase>prepare-package</phase><goals><goal>build-classpath</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
