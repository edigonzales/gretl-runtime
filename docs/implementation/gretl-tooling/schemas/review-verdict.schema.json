{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-verdict.schema.json",
  "title": "GRETL Tooling independent review verdict",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6",
        "P7",
        "P8"
      ]
    },
    "assignmentBase": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phaseBase": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "requirementsDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "openCodeVersion": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "apiHost": {
          "type": "string",
          "minLength": 1
        },
        "modelMappingEvidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "openCodeVersion",
        "provider",
        "model",
        "apiHost",
        "modelMappingEvidence"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-8]-0[1-9]$"
          },
          "status": {
            "enum": [
              "fulfilled",
              "violated",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "status",
          "evidence",
          "findingIds"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "fulfilled"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 9,
      "maxItems": 81
    },
    "executedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "testCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "failures": {
            "type": "integer",
            "minimum": 0
          },
          "skips": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "cwd",
          "argv",
          "exitCode",
          "testCount",
          "failures",
          "skips",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "verifiedCurrentEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "candidateSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "sha256",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "checkIds",
          "candidateSha",
          "artifacts",
          "evidence",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "guiEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^G(?:0[1-9]|[12][0-9]|30)$"
            },
            "minItems": 1
          },
          "kind": {
            "enum": [
              "own-run",
              "verified-current"
            ]
          },
          "actions": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "string",
            "minLength": 1
          },
          "screenshots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "sha256",
                "kind"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "caseIds",
          "kind",
          "actions",
          "observations",
          "screenshots",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "counterprobes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "novelty": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "hypothesis",
          "novelty",
          "actions",
          "expected",
          "observed",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "openMandatoryFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[0-8]-0[1-9]$"
            },
            "minItems": 1
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "reproduction": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "requiredCorrection": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "criteria",
          "severity",
          "source",
          "reproduction",
          "expected",
          "observed",
          "requiredCorrection"
        ],
        "additionalProperties": false
      }
    },
    "missingRequiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report": {
      "const": "review.md"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "blocker": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "INFRA",
            "MODEL_IDENTITY",
            "REVIEW_TRANSPORT",
            "MISSING_EVIDENCE",
            "SCOPE_DECISION"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "unblockAction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "category",
        "reason",
        "unblockAction"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "reviewId",
    "phase",
    "assignmentBase",
    "phaseBase",
    "candidateSha",
    "requirementsDigest",
    "verdict",
    "reviewer",
    "criteria",
    "executedChecks",
    "verifiedCurrentEvidence",
    "guiEvidence",
    "counterprobes",
    "openMandatoryFindings",
    "missingRequiredChecks",
    "report",
    "summary"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "P8"
          }
        }
      },
      "then": {
        "properties": {
          "criteria": {
            "minItems": 81,
            "maxItems": 81
          }
        }
      },
      "else": {
        "properties": {
          "criteria": {
            "minItems": 9,
            "maxItems": 9
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "criteria": {
            "items": {
              "properties": {
                "status": {
                  "const": "fulfilled"
                },
                "findingIds": {
                  "maxItems": 0
                }
              }
            }
          },
          "executedChecks": {
            "minItems": 1,
            "items": {
              "properties": {
                "exitCode": {
                  "const": 0
                },
                "failures": {
                  "const": 0
                }
              }
            }
          },
          "counterprobes": {
            "minItems": 1
          },
          "openMandatoryFindings": {
            "maxItems": 0
          },
          "missingRequiredChecks": {
            "maxItems": 0
          },
          "reviewer": {
            "properties": {
              "openCodeVersion": {
                "pattern": "^2\\.[0-9]+\\.[0-9]+"
              },
              "provider": {
                "const": "deepseek"
              },
              "model": {
                "const": "deepseek-flash"
              },
              "apiHost": {
                "const": "api.deepseek.com"
              }
            }
          }
        },
        "not": {
          "required": [
            "blocker"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          },
          "phase": {
            "enum": [
              "P5",
              "P6",
              "P7",
              "P8"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "guiEvidence": {
            "minItems": 1,
            "contains": {
              "properties": {
                "kind": {
                  "const": "own-run"
                }
              },
              "required": [
                "kind"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          },
          "phase": {
            "const": "P8"
          }
        }
      },
      "then": {
        "properties": {
          "counterprobes": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "required": [
          "blocker"
        ]
      }
    }
  ]
}
