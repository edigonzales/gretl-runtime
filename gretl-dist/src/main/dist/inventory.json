{
  "schemaVersion": 1,
  "runtime": "gretl-runtime",
  "version": "${project.version}",
  "java": "25",
  "groovy": "6.0.0",
  "modules": [
    "gretl-api",
    "gretl-runner",
    "gretl-groovy",
    "gretl-i18n",
    "gretl-logging",
    "gretl-basic-tasks",
    "gretl-core-tasks",
    "gretl-ilivalidator",
    "gretl-cli",
    "gretl-packager",
    "gretl-job-runtime"
  ],
  "tasks": ["HttpDownload", "Curl", "Gzip", "Extract", "FtpList", "FtpDownload", "FtpUpload", "FtpDelete", "S3Download", "S3Upload", "S3Delete", "S3Bucket2Bucket", "Db2Db", "DuckDbSqlExecutor", "Csv2Excel", "CsvImport", "CsvExport", "JsonImport", "CsvValidator", "JsonValidator", "Gpkg2Shp", "GpkgValidator", "ShpValidator", "SqlExecutor", "XslTransformer", "IliValidator"],
  "extensionDirectory": "lib/extensions",
  "taskArtifacts": [
    "gretl-basic-tasks-${project.version}.jar",
    "gretl-core-tasks-${project.version}.jar",
    "gretl-ilivalidator-${project.version}.jar"
  ],
  "packager": "gretl package job-package.json --output job.jar",
  "dependencyVersions": {
    "groovy": "6.0.0",
    "slf4j": "2.0.20",
    "logback": "1.6.5",
    "commons-compress": "1.27.1",
    "postgresql": "42.7.14",
    "ilivalidator": "1.15.0",
    "saxon": "11.4",
    "xmlresolver": "4.4.3",
    "commons-net": "3.6",
    "aws-sdk": "2.15.64",
    "duckdb": "1.5.2.0",
    "commons-csv": "1.12.0",
    "commons-io": "2.18.0",
    "poi": "5.2.5",
    "jackson": "2.17.2",
    "sqlite-jdbc": "3.53.2.0"
  },
  "sourceRevision": "working-tree; release build must provide the source commit",
  "checksumsFile": "SHA256SUMS"
}
